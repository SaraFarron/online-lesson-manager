ENVIRONMENT=local
DATABASE_URL=sqlite+aiosqlite:///./dev.db
AUTH_JWT_SECRET=replace-with-an-independent-random-signing-secret
AUTH_JWT_EXP_MINUTES=30
TELEGRAM_SERVICE_CREDENTIAL=replace-with-a-random-service-secret-at-least-32-characters
HOMEWORK_STORAGE_PATH=./homework-storage

BOT_TOKEN=replace-with-token-from-BotFather
BOT_BACKEND_URL=http://127.0.0.1:8093
BOT_SERVICE_CREDENTIAL=replace-with-the-same-value-as-TELEGRAM_SERVICE_CREDENTIAL
BOT_REQUEST_TIMEOUT=10
BOT_RECOVERY_SECONDS=15
BOT_FAILURE_THRESHOLD=3

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=app
POSTGRES_PORT=5432
# Host-side URL for PostgreSQL concurrency tests with docker-compose.yml.
SCHEDULE_TEST_DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-database-password@localhost:5432/app
BOT_COMPOSE_BACKEND_URL=http://app:8000
